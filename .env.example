# =================================================================
# CẤU HÌNH KẾT NỐI SUPABASE & SERVER
# Hướng dẫn lấy URL & Key:
# 1. Truy cập https://supabase.com -> Chọn Project của bạn
# 2. Vào mục Project Settings (Biểu tượng bánh răng) -> Chọn mục "API"
# 3. Copy "Project URL" dán vào SUPABASE_URL
# 4. Copy "anon public" API key dán vào SUPABASE_ANON_KEY
# =================================================================

# Cổng khởi chạy Server Node.js Express (Mặc định: 3000)
PORT=3000

# URL của dự án Supabase (Ví dụ: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Khóa bí mật công khai (anon / public key) của Supabase
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Tùy chọn Service Role Key (Nếu cần toàn quyền bypass RLS phía backend)
SUPABASE_SERVICE_ROLE_KEY=

# =================================================================
# CẤU HÌNH THÔNG TIN SHOP & TÀI KHOẢN NHẬN TIỀN (VIETQR)
# =================================================================
SHOP_NAME=NGỌC COSMETICS & LUCKY GAME
SHOP_PHONE=0988 123 456
SHOP_BANK_CODE=MB
SHOP_BANK_NAME=MB Bank (Ngân hàng Quân Đội)
SHOP_BANK_ACCOUNT=999988886666
SHOP_BANK_OWNER=DUONG THI KHANH NGOC
